{
  "name": "reconex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "jest",
    "test:typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:build": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\" && cross-env SKIP_ENV_VALIDATION=true NEXT_TELEMETRY_DISABLED=1 next build",
    "test:ci": "npm run test:typecheck && npm run lint && npm test && npm run test:build && npm run test:e2e",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prisma:generate": "prisma generate",
    "prisma:dev:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "compose:up": "bash ./scripts/compose.sh up -d --build",
    "compose:down": "bash ./scripts/compose.sh down --remove-orphans",
    "compose:ps": "bash ./scripts/compose.sh ps",
    "compose:logs": "bash ./scripts/compose.sh logs -f --tail=200",
    "compose:db": "bash ./scripts/compose.sh up -d db",
    "inspect:bac": "node ./scripts/inspect-bac.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@getbrevo/brevo": "^3.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.4",
    "@mui/material": "^7.3.4",
    "@mui/x-charts": "^8.16.0",
    "@mui/x-date-pickers": "^8.18.0",
    "@prisma/client": "^6.18.0",
    "@t3-oss/env-nextjs": "^0.13.8",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-table": "^3.13.0",
    "@tiptap/extension-table-cell": "^3.13.0",
    "@tiptap/extension-table-header": "^3.13.0",
    "@tiptap/extension-table-row": "^3.13.0",
    "@tiptap/react": "^3.10.1",
    "@tiptap/starter-kit": "^3.10.1",
    "axios": "^1.12.2",
    "csv-parse": "^5.6.0",
    "dayjs": "^1.11.13",
    "decimal.js": "^10.6.0",
    "material-react-table": "^3.2.1",
    "mui-chips-input": "^7.0.1",
    "mui-tiptap": "^1.28.1",
    "next": "14.2.3",
    "next-auth": "^4.24.13",
    "notistack": "^3.0.2",
    "pino": "^10.1.0",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.65.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@storybook/addon-docs": "^9.1.15",
    "@storybook/addon-onboarding": "^9.1.15",
    "@storybook/nextjs": "^9.1.15",
    "@storybook/react": "^9.1.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2",
    "prisma": "^6.18.0",
    "storybook": "^9.1.15",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "undici": "^7.4.0"
  }
}
