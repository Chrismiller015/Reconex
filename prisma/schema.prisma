// datasource and generator definitions
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  name          String?
  email         String?  @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  posts         Post[]
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @map("refresh_token")
  access_token      String? @map("access_token")
  expires_at        Int?    @map("expires_at")
  token_type        String? @map("token_type")
  scope             String?
  id_token          String? @map("id_token")
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String
  published Boolean  @default(true)
  author    User?    @relation(fields: [authorId], references: [id])
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UploadedSchemaType {
  GM
  DI
  UNKNOWN
}

enum CompareRunStatus {
  PENDING
  RUNNING
  COMPLETE
  FAILED
}

model UploadedFile {
  id                   String             @id @default(cuid())
  originalName         String
  storedPath           String
  mimeType             String?
  extension            String?
  sizeBytes            Int
  sha256               String
  uploadedAt           DateTime           @default(now())
  uploadedBy           String?
  rowCount             Int
  schemaType           UploadedSchemaType
  requiredFieldsPresent Json
  missingFields        Json

  runsAsDi CompareRun[] @relation("DiFile")
  runsAsGm CompareRun[] @relation("GmFile")

  @@index([uploadedAt])
}

model CompareRun {
  id         String           @id @default(cuid())
  diFileId   String
  gmFileId   String
  status     CompareRunStatus @default(PENDING)
  errorMessage String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  lastRunAt  DateTime?

  diFile UploadedFile @relation("DiFile", fields: [diFileId], references: [id], onDelete: Restrict)
  gmFile UploadedFile @relation("GmFile", fields: [gmFileId], references: [id], onDelete: Restrict)

  varianceGroups VarianceGroup[]

  @@index([updatedAt])
}

model VarianceGroup {
  id          String     @id @default(cuid())
  runId       String
  bac         String
  brandToken  String
  productCode String
  diAmount    Decimal
  gmAmount    Decimal
  delta       Decimal
  flags       Json
  isRemoved   Boolean    @default(false)
  category    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  run   CompareRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  notes VarianceNote[]

  @@unique([runId, bac, brandToken, productCode])
  @@index([runId, bac])
}

model VarianceNote {
  id              String       @id @default(cuid())
  varianceGroupId String
  noteText        String
  author          String?
  createdAt       DateTime     @default(now())

  varianceGroup VarianceGroup @relation(fields: [varianceGroupId], references: [id], onDelete: Cascade)
  @@index([varianceGroupId])
}
